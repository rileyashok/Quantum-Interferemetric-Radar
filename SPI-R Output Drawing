   def draw_detection_lines(self):
       for line in self.detection_lines:
           if line['type'] == 'radial':
               if line['active']:
                   pygame.draw.line(self.screen, (100, 200, 100), line['start'], line['end'], 1)
                   for point in line['intersections']:
                       pygame.draw.circle(self.screen, (200, 100, 100), point, 3)
           elif line['type'] == 'circular':
               if not line['active']:
                   for i in range(0, len(line['points']), 4):
                       if i+1 < len(line['points']):
                           pygame.draw.line(self.screen, (80, 80, 80), line['points'][i], line['points'][i+1], 1)
               else:
                   pygame.draw.circle(self.screen, (100, 150, 200), line['center'], line['radius'], 1)
                   for point in line['intersections']:
                       pygame.draw.circle(self.screen, (200, 100, 100), point, 3)
      
       if len(self.shape_points) > 2:
           center_x, center_y = WIDTH // 2, HEIGHT // 2
           sorted_points = sorted(self.shape_points, key=lambda pt: math.atan2(pt[1] - center_y, pt[0] - center_x))
           sorted_points.append(sorted_points[0])
           pygame.draw.lines(self.screen, (255, 200, 0), False, sorted_points, 2)


   def draw_plane(self, x, y, angle=0):
       plane_color = STEALTH_GRAY if self.is_stealth else SILVER
      
       body_length = self.plane_length * 2
       body_width = self.plane_width * 2
      
       # Create points for plane shape
       nose = (body_length/2, 0)
       tail = (-body_length/2, 0)
       wing_left = (-body_length/6, -body_width/2)
       wing_right = (-body_length/6, body_width/2)
       tail_top = (-body_length/2.2, -body_width/5)
       tail_bottom = (-body_length/2.2, body_width/5)
      
       # Rotation matrix
       cos_a = math.cos(math.radians(angle))
       sin_a = math.sin(math.radians(angle))
      
       def rotate_point(px, py):
           rotated_x = px * cos_a - py * sin_a + x
           rotated_y = px * sin_a + py * cos_a + y
           return (rotated_x, rotated_y)
      
       # Calculate points
       fuselage_points = [rotate_point(*nose), rotate_point(0, -body_width/6),
                          rotate_point(*tail), rotate_point(0, body_width/6)]
       left_wing_points = [rotate_point(-body_length/5, -body_width/8), rotate_point(*wing_left)]
       right_wing_points = [rotate_point(-body_length/5, body_width/8), rotate_point(*wing_right)]
       tail_wing_points = [rotate_point(-body_length/2.5, -body_width/15), rotate_point(*tail_top),
                           rotate_point(-body_length/2.5, body_width/15), rotate_point(*tail_bottom)]
      
       # Draw the plane components
       pygame.draw.polygon(self.screen, plane_color, fuselage_points)
       pygame.draw.line(self.screen, plane_color, *left_wing_points, 3)
       pygame.draw.line(self.screen, plane_color, *right_wing_points, 3)
       pygame.draw.polygon(self.screen, plane_color, tail_wing_points)
      
       # Store all points for collision detection
       self.plane_points = fuselage_points + [left_wing_points[0], left_wing_points[1],
                                             right_wing_points[0], right_wing_points[1]] + tail_wing_points


   def update_detection(self):
       # Reset all lines
       for line in self.detection_lines:
           line['active'] = False
           line['intersections'] = []
      
       self.shape_points = []
      
       if not hasattr(self, 'plane_points'):
           return
      
       # Check intersections
       for line in self.detection_lines:
           intersections = []
           if line['type'] == 'radial':
               line_start_x, line_start_y = line['start']
               line_end_x, line_end_y = line['end']
              
               for i in range(len(self.plane_points)):
                   p1 = self.plane_points[i]
                   p2 = self.plane_points[(i + 1) % len(self.plane_points)]
                  
                   # Line segment intersection calculation
                   x1, y1 = line_start_x, line_start_y
                   x2, y2 = line_end_x, line_end_y
                   x3, y3 = p1
                   x4, y4 = p2
                  
                   den = (y4 - y3) * (x2 - x1) - (x4 - x3) * (y2 - y1)
                  
                   if den != 0:
                       t = ((x4 - x3) * (y1 - y3) - (y4 - y3) * (x1 - x3)) / den
                       u = -((x2 - x1) * (y1 - y3) - (y2 - y1) * (x1 - x3)) / den
                      
                       if 0 <= t <= 1 and 0 <= u <= 1:
                           px = x1 + t * (x2 - x1)
                           py = y1 + t * (y2 - y1)
                          
                           detection_probability = 0.7 if self.is_stealth else 1.0
                           if random.random() < detection_probability:
                               intersections.append((px, py))
                               if (px, py) not in self.shape_points:
                                   self.shape_points.append((px, py))
          
           # For circular lines - simplified
           elif line['type'] == 'circular':
               center_x, center_y = line['center']
               radius = line['radius']
              
               for p in self.plane_points:
                   x, y = p
                   dist = math.sqrt((x - center_x)**2 + (y - center_y)**2)
                   if abs(dist - radius) < 5:
                       if p not in self.shape_points:
                           self.shape_points.append(p)
                           intersections.append(p)
              
           if intersections:
               line['active'] = True
               line['intersections'] = intersections
      
       # Calculate dimensions
       if len(self.shape_points) > 2:
           min_x = min(p[0] for p in self.shape_points)
           max_x = max(p[0] for p in self.shape_points)
           min_y = min(p[1] for p in self.shape_points)
           max_y = max(p[1] for p in self.shape_points)
          
           self.detected_dimensions['length'] = (max_x - min_x) / 2
           self.detected_dimensions['width'] = (max_y - min_y) / 2
          
           # Calculate wingspan
           max_dist = 0
           for p1 in self.shape_points:
               for p2 in self.shape_points:
                   dist = math.sqrt((p2[0] - p1[0])**2 + (p2[1] - p1[1])**2)
                   max_dist = max(max_dist, dist)
           self.detected_dimensions['wingspan'] = max_dist / 2


   def update_animation(self):
       elapsed_time = time.time() - self.start_time
       self.elapsed_time = elapsed_time
      
       # Keep plane centered
       self.plane_x = WIDTH // 2
       self.plane_y = HEIGHT // 2
      
       # Apply rotation
       self.plane_angle = self.plane_direction + (math.sin(elapsed_time * 0.2) * 5)
       self.update_detection()
      
       # Check if animation is complete
       if elapsed_time >= 5:
           self.state = self.STATE_COMPLETE


