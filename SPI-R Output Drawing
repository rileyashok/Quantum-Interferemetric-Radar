import pygame
import sys
import time

# Initialize Pygame
pygame.init()

# Screen dimensions
WIDTH, HEIGHT = 800, 600

# Colors
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
RED = (255, 50, 50)
BLUE = (50, 100, 255)
GREEN = (0, 255, 0)
GRAY = (150, 150, 150)

# Simulation parameters
BEAM_DISTANCE = 20.0  # meters
SATELLITE_HEIGHT = 35000  # meters
TIME_SILENT = 0.2  # seconds
TIME_RIGHT = 0.1  # seconds

# Calculated metrics
PLANE_LENGTH = ((TIME_SILENT / TIME_RIGHT) + 1) * BEAM_DISTANCE
PLANE_VELOCITY = BEAM_DISTANCE / TIME_RIGHT

# Setup display
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("SPI-R Plane Detection")
clock = pygame.time.Clock()
font = pygame.font.Font(None, 24)

# Simulation states
STATE_READY = 0
STATE_RUNNING = 1
STATE_COMPLETE = 2

# Initialize state
state = STATE_READY
start_time = 0
plane_x = -100

def draw_background():
    screen.fill(RED)
    title = font.render("SPI-R Plane Detection Simulation", True, WHITE)
    screen.blit(title, (WIDTH // 2 - title.get_width() // 2, 50))

def draw_satellite():
    pygame.draw.rect(screen, GRAY, (WIDTH // 2 - 20, 100, 40, 20))

def draw_beams():
    beam1_x = WIDTH // 2 - 100
    beam2_x = WIDTH // 2 + 100
    
    pygame.draw.line(screen, GREEN, (beam1_x, 150), (beam1_x, 400), 3)
    pygame.draw.line(screen, BLUE, (beam2_x, 150), (beam2_x, 400), 3)

def draw_plane(x):
    pygame.draw.rect(screen, GRAY, (x, 250, 50, 10))

def draw_results():
    results = [
        f"Plane Length: {PLANE_LENGTH:.2f} m",
        f"Plane Velocity: {PLANE_VELOCITY:.2f} m/s",
        f"Beam Distance: {BEAM_DISTANCE} m"
    ]
    
    for i, result in enumerate(results):
        text = font.render(result, True, WHITE)
        screen.blit(text, (WIDTH // 2 - text.get_width() // 2, 400 + i * 30))

def update_animation():
    global plane_x, state
    
    elapsed_time = time.time() - start_time
    
    # Debugging print statement to check time and plane position
    print(f"Elapsed Time: {elapsed_time:.2f}, Plane X: {plane_x}")
    
    if elapsed_time < 2:
        # Plane approaching first beam
        plane_x = -100 + elapsed_time * 300
    elif elapsed_time < 3:
        # Plane between beams
        plane_x = WIDTH // 2 - 25
    elif elapsed_time < 4:
        # Plane after second beam
        plane_x = WIDTH // 2 + 100 + (elapsed_time - 3) * 300
    else:
        # Plane has passed all points, end simulation
        state = STATE_COMPLETE
        plane_x = WIDTH // 2 + 100  # Position the plane after the second beam.

def main():
    global state, start_time, plane_x
    
    while True:
        # Event handling
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
                sys.exit()
            
            if event.type == pygame.MOUSEBUTTONDOWN:
                if state == STATE_READY:
                    state = STATE_RUNNING
                    start_time = time.time()  # Reset the start time when the simulation starts
                elif state == STATE_COMPLETE:
                    state = STATE_READY
                    plane_x = -100
        
        # Drawing
        draw_background()
        draw_satellite()
        draw_beams()
        
        # Animation logic
        if state == STATE_RUNNING:
            update_animation()
            draw_plane(plane_x)
        
        if state == STATE_COMPLETE:
            draw_plane(plane_x)
            draw_results()
        
        # Update display
        pygame.display.flip()
        clock.tick(30)

if __name__ == "__main__":
    main()
