import numpy as np
import matplotlib.pyplot as plt

# Constants for reference
beamDistance = 20.0  # d
timeSilent = 0.0  # ts
timeRight = 0.0  # tr

# Variables for find_length
parenthesis1 = 0.0
parenthesis2 = 0.0
planeLength = 0.0  # Length of the plane

# Variables for find_velocity
planeVelocity = 0.0  # Velocity of the plane

# Variables for find_altitude
heightInitial = 35000  # h0, meters, height of the satellite
heightPlane = 0.0  # h2
halfBeamDistance = 10  # w0, half the beam distance

# Functions for calculations
def find_length(timeSilent, timeRight):
    global parenthesis1, parenthesis2, planeLength
    parenthesis1 = timeSilent / timeRight
    parenthesis2 = parenthesis1 + 1
    planeLength = parenthesis2 * beamDistance
    return planeLength

def find_velocity(timeRight):
    global planeVelocity
    planeVelocity = beamDistance / timeRight
    return planeVelocity

def find_altitude(t2):
    global heightPlane
    d1 = find_velocity(timeRight) * (t2)
    heightPlane = (heightInitial * d1) / halfBeamDistance
    return heightPlane

# Main code to accept user input
try:
    # Input values
    timeSilent = float(input("Enter the TimeSilent: "))
    timeRight = float(input("Enter the Time Right: "))
    t2 = float(input("Enter the time at which the cone was hit after the cylinder: "))

    # Perform calculations
    length = find_length(timeSilent, timeRight)
    planeVelocity = find_velocity(timeRight)
    heightPlane = find_altitude(t2)

    # Output calculated values
    print(f"The length of the plane is: {length} meters")
    print(f"The velocity of the plane is: {planeVelocity} m/s")
    print(f"The altitude of the plane is: {heightPlane} meters")

except ValueError:
    print("Invalid input. Please enter numeric values.")

# Visualization of Plane Velocity and Altitude over Time
# Generate time values for the plot
time = np.linspace(0, 100, 100)  # Time from 0 to 100 seconds

# Compute velocity and altitude over time
velocity = np.array([find_velocity(t) for t in time])  # Replace 't' with actual time steps
altitude = np.array([find_altitude(t) for t in time])  # Replace 't' with actual time steps

# Plotting the velocity vs time
plt.figure(figsize=(12, 6))

# Plot for velocity over time
plt.subplot(1, 2, 1)
plt.plot(time, velocity, color='b')
plt.title('Plane Velocity over Time')
plt.xlabel('Time (s)')
plt.ylabel('Velocity (m/s)')
plt.grid(True)

# Plot for altitude over time
plt.subplot(1, 2, 2)
plt.plot(time, altitude, color='g')
plt.title('Plane Altitude over Time')
plt.xlabel('Time (s)')
plt.ylabel('Altitude (m)')
plt.grid(True)

plt.tight_layout()
plt.show()
