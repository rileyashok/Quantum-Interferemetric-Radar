   def create_detection_lines(self):
       lines = []
       center_x, center_y = WIDTH // 2, HEIGHT // 2
      
       # Create radial lines
       for angle in range(0, 360, 15):
           rad = math.radians(angle)
           end_x = center_x + 400 * math.cos(rad)
           end_y = center_y + 400 * math.sin(rad)
          
           lines.append({
               'id': f"r-{angle}",
               'start': [center_x, center_y],
               'end': [end_x, end_y],
               'type': 'radial',
               'angle': angle,
               'active': False,
               'intersections': []
           })
      
       # Add circles for dimension analysis
       for radius in range(50, 301, 50):
           points = []
           for angle in range(0, 360, 10):
               rad = math.radians(angle)
               x = center_x + radius * math.cos(rad)
               y = center_y + radius * math.sin(rad)
               points.append((x, y))
          
           lines.append({
               'id': f"c-{radius}",
               'center': [center_x, center_y],
               'radius': radius,
               'points': points,
               'type': 'circular',
               'active': False,
               'intersections': []
           })
      
       return lines


