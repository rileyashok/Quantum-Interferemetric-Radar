import pygame
import sys
import time
import math
import random

# Initialize Pygame
pygame.init()

# Screen dimensions and colors
WIDTH, HEIGHT = 1000, 700
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
SKY_BLUE = (135, 206, 235)
DEEP_SKY_BLUE = (100, 149, 237)
RED = (255, 50, 50)
BLUE = (50, 100, 255)
GREEN = (0, 100, 0)
GRAY = (150, 150, 150)
SILVER = (192, 192, 192)
STEALTH_GRAY = (70, 70, 70)

class AircraftDetectionSimulation:
    def __init__(self):
        # Screen setup
        self.screen = pygame.display.set_mode((WIDTH, HEIGHT))
        pygame.display.set_caption("Aircraft Shape Detection Simulation")
        self.clock = pygame.time.Clock()
        self.font = pygame.font.Font(None, 24)
        self.title_font = pygame.font.Font(None, 36)
        
        # Generate stars for background
        self.stars = [(random.randint(0, WIDTH), random.randint(0, 200), 
                       random.randint(1, 3), (random.randint(200, 255),)*3) 
                       for _ in range(100)]
        
        # Aircraft parameters
        self.plane_length = 0
        self.plane_width = 0
        self.plane_speed = 0
        self.plane_direction = 0
        self.plane_altitude = 0
        self.is_stealth = False
        
        # Simulation states
        self.STATE_INPUT = 0
        self.STATE_RUNNING = 1
        self.STATE_COMPLETE = 2
        self.state = self.STATE_INPUT
        
        # Animation variables
        self.start_time = 0
        self.plane_x = -100
        self.plane_y = HEIGHT//2
        self.plane_angle = 0
        self.elapsed_time = 0
        
        # Input fields
        self.input_fields = [
            {"label": "Plane Length (m):", "value": "", "rect": pygame.Rect(WIDTH//2 - 150, 300, 200, 30)},
            {"label": "Plane Width (m):", "value": "", "rect": pygame.Rect(WIDTH//2 - 150, 350, 200, 30)},
            {"label": "Plane Speed (m/s):", "value": "", "rect": pygame.Rect(WIDTH//2 - 150, 400, 200, 30)},
            {"label": "Direction (degrees):", "value": "", "rect": pygame.Rect(WIDTH//2 - 150, 450, 200, 30)},
            {"label": "Altitude (m):", "value": "", "rect": pygame.Rect(WIDTH//2 - 150, 500, 200, 30)},
            {"label": "Stealth (Y/N):", "value": "", "rect": pygame.Rect(WIDTH//2 - 150, 550, 200, 30)}
        ]
        self.active_input = None
        
        # Shape detection system
        self.shape_points = []
        self.detected_dimensions = {
            'length': 0,
            'width': 0,
            'wingspan': 0
        }
    
    def draw_sky_background(self):
        # Gradient sky background
        for y in range(HEIGHT):
            r = int(DEEP_SKY_BLUE[0] + (SKY_BLUE[0] - DEEP_SKY_BLUE[0]) * (y / HEIGHT))
            g = int(DEEP_SKY_BLUE[1] + (SKY_BLUE[1] - DEEP_SKY_BLUE[1]) * (y / HEIGHT))
            b = int(DEEP_SKY_BLUE[2] + (SKY_BLUE[2] - DEEP_SKY_BLUE[2]) * (y / HEIGHT))
            pygame.draw.line(self.screen, (r, g, b), (0, y), (WIDTH, y))
        
        # Draw subtle grid and stars
        for x in range(0, WIDTH, 50):
            pygame.draw.line(self.screen, (50, 50, 50), (x, 0), (x, HEIGHT), 1)
        for y in range(0, HEIGHT, 50):
            pygame.draw.line(self.screen, (50, 50, 50), (0, y), (WIDTH, y), 1)
        
        for star in self.stars:
            pygame.draw.circle(self.screen, star[3], (star[0], star[1]), star[2])
    
    def draw_input_screen(self):
        self.draw_sky_background()
        
        # Title
        title = self.title_font.render("Aircraft Shape Detection Simulation", True, WHITE)
        self.screen.blit(title, (WIDTH // 2 - title.get_width() // 2, 50))
        
        # Instructions
        instructions = self.font.render("Enter the aircraft parameters to begin the simulation", True, WHITE)
        self.screen.blit(instructions, (WIDTH // 2 - instructions.get_width() // 2, 100))
        
        # Input fields
        for field in self.input_fields:
            # Label
            label = self.font.render(field["label"], True, WHITE)
            self.screen.blit(label, (field["rect"].x - label.get_width() - 10, field["rect"].y + 5))
            
            # Input box
            color = BLUE if field == self.active_input else GRAY
            pygame.draw.rect(self.screen, color, field["rect"], 2)
            pygame.draw.rect(self.screen, (30, 30, 30), field["rect"])
            
            # Input text
            text_surface = self.font.render(field["value"], True, WHITE)
            self.screen.blit(text_surface, (field["rect"].x + 5, field["rect"].y + 5))
        
        # Start button
        start_button = pygame.Rect(WIDTH//2 - 75, 600, 150, 40)
        pygame.draw.rect(self.screen, GREEN, start_button)
        start_text = self.font.render("START", True, WHITE)
        self.screen.blit(start_text, (start_button.x + (start_button.width - start_text.get_width()) // 2, start_button.y + 10))
        
        return start_button
    
    def draw_satellite(self):
        # Satellite position - fixed position
        sat_x, sat_y = WIDTH // 2, 80
        
        # Main body and solar panels
        pygame.draw.rect(self.screen, GRAY, (sat_x - 40, sat_y - 10, 80, 20))
        pygame.draw.rect(self.screen, SILVER, (sat_x - 60, sat_y - 15, 20, 30))
        pygame.draw.rect(self.screen, SILVER, (sat_x + 40, sat_y - 15, 20, 30))
        
        # Static radar beams
        beam_angle1 = 25
        beam_angle2 = -25
        
        beam1_end_x = sat_x + math.tan(math.radians(beam_angle1)) * (HEIGHT - sat_y)
        beam2_end_x = sat_x + math.tan(math.radians(beam_angle2)) * (HEIGHT - sat_y)
        
        # Static beams
        beam_color = (255, 0, 0, 40)  # Transparent red
        pygame.draw.line(self.screen, beam_color, (sat_x, sat_y), (beam1_end_x, HEIGHT), 1)
        pygame.draw.line(self.screen, beam_color, (sat_x, sat_y), (beam2_end_x, HEIGHT), 1)
        
        # Add two new vertical beams on either side
        vertical_beam1_x = sat_x - 150  # Left vertical beam
        vertical_beam2_x = sat_x + 150  # Right vertical beam
        pygame.draw.line(self.screen, beam_color, (vertical_beam1_x, HEIGHT), (vertical_beam1_x, sat_y), 1)
        pygame.draw.line(self.screen, beam_color, (vertical_beam2_x, HEIGHT), (vertical_beam2_x, sat_y), 1)
    
    def draw_plane(self, x, y, angle=0):
        # Plane color based on stealth status
        plane_color = STEALTH_GRAY if self.is_stealth else SILVER
        
        # Scale with plane dimensions
        body_length = self.plane_length * 2  # Scale factor for visualization
        body_width = self.plane_width * 2
        
        # Create a simple plane shape
        # Simple triangle for the fuselage with rectangle wings
        
        # Rotation matrix
        cos_a = math.cos(math.radians(angle))
        sin_a = math.sin(math.radians(angle))
        
        # Rotate and translate points
        def rotate_point(px, py):
            rotated_x = px * cos_a - py * sin_a + x
            rotated_y = px * sin_a + py * cos_a + y
            return (rotated_x, rotated_y)
        
        # Simple plane shape
        # Body (triangle)
        nose = rotate_point(body_length/2, 0)
        tail_top = rotate_point(-body_length/2, -body_width/4)
        tail_bottom = rotate_point(-body_length/2, body_width/4)
        
        # Wings (rectangle)
        wing_left_front = rotate_point(0, -body_width/2)
        wing_left_back = rotate_point(-body_length/4, -body_width/2)
        wing_right_front = rotate_point(0, body_width/2)
        wing_right_back = rotate_point(-body_length/4, body_width/2)
        
        # Draw body
        pygame.draw.polygon(self.screen, plane_color, [nose, tail_top, tail_bottom])
        
        # Draw wings
        pygame.draw.polygon(self.screen, plane_color, 
                          [wing_left_front, wing_left_back,
                           wing_right_back, wing_right_front])
        
        # Store all points for collision detection
        self.plane_points = [nose, tail_top, tail_bottom, 
                            wing_left_front, wing_left_back,
                            wing_right_front, wing_right_back]
    
    def update_detection(self):
        # Reset detection data
        self.shape_points = []
        
        # Get plane corners
        if not hasattr(self, 'plane_points'):
            return
        
        # Simple shape detection - just store key points of the aircraft
        for point in self.plane_points:
            # Add detection probability calculation for stealth aircraft
            detection_probability = 0.3 if self.is_stealth else 0.9  # Lower detection for stealth
            if random.random() < detection_probability:
                self.shape_points.append(point)
        
        # Calculate basic dimensions based on detected points
        if self.shape_points:
            # Find extreme coordinates
            min_x = min(p[0] for p in self.shape_points)
            max_x = max(p[0] for p in self.shape_points)
            min_y = min(p[1] for p in self.shape_points)
            max_y = max(p[1] for p in self.shape_points)
            
            # Set detected dimensions
            self.detected_dimensions['length'] = (max_x - min_x) / 2  # Scale back to real units
            self.detected_dimensions['width'] = (max_y - min_y) / 2
    
    def get_shape_classification(self):
        # Analyze detected points to classify aircraft shape
        if len(self.shape_points) < 3:
            return "Unknown (insufficient data)"
        
        # Calculate aspect ratio
        if self.detected_dimensions['length'] > 0 and self.detected_dimensions['width'] > 0:
            aspect_ratio = self.detected_dimensions['length'] / self.detected_dimensions['width']
            
            if aspect_ratio > 7:
                return "Likely Reconnaissance Aircraft (high aspect ratio wings)"
            elif aspect_ratio > 5:
                return "Standard Fighter Aircraft"
            elif aspect_ratio > 3:
                return "Commercial Passenger Aircraft"
            elif aspect_ratio > 1.5:
                return "Transport/Cargo Aircraft"
            else:
                return "Unknown Aircraft Type"
        else:
            return "Shape Analysis Incomplete"
    
    def update_animation(self):
        # Animation progress
        elapsed_time = time.time() - self.start_time
        self.elapsed_time = elapsed_time
        total_animation_time = 5  # Shorter simulation time
        
        # Calculate normalized time (0 to 1)
        t = min(elapsed_time / total_animation_time, 1)
        
        # Smooth animation curve
        t_smooth = 3 * t**2 - 2 * t**3  # Cubic ease
        
        # Calculate plane position
        path_width = WIDTH + 200
        
        self.plane_x = -100 + t_smooth * path_width
        
        # Add slight vertical movement
        vertical_offset = math.sin(t * math.pi * 2) * 50
        self.plane_y = HEIGHT / 2 + vertical_offset
        
        # Adjust angle based on vertical movement and direction
        self.plane_angle = self.plane_direction + math.sin(t * math.pi * 2) * 5
        
        # Update detection
        self.update_detection()
        
        # Check if animation is complete
        if t >= 1:
            self.state = self.STATE_COMPLETE
    
    def draw_results(self):
        # Background for results panel
        results_panel = pygame.Rect(WIDTH // 2 - 250, 150, 500, 400)
        pygame.draw.rect(self.screen, (0, 0, 0, 128), results_panel)
        pygame.draw.rect(self.screen, WHITE, results_panel, 2)
        
        # Panel title
        title = self.title_font.render("Shape Detection Results", True, WHITE)
        self.screen.blit(title, (WIDTH // 2 - title.get_width() // 2, 160))
        
        # Result data
        results = [
            f"Actual Plane Length: {self.plane_length:.2f} m",
            f"Actual Plane Width: {self.plane_width:.2f} m",
            f"Detected Length: {self.detected_dimensions['length']:.2f} m",
            f"Detected Width: {self.detected_dimensions['width']:.2f} m",
            f"Detection Accuracy: {self.get_detection_accuracy():.1f}%",
            f"Shape Points Detected: {len(self.shape_points)}",
            f"Aircraft Classification: {self.get_shape_classification()}",
            f"Stealth Status: {'Stealth' if self.is_stealth else 'Conventional'}",
            f"Detection Quality: {self.get_detection_quality()}"
        ]
        
        for i, result in enumerate(results):
            text = self.font.render(result, True, WHITE)
            self.screen.blit(text, (WIDTH // 2 - 220, 200 + i * 30))
        
        # Draw restart button
        restart_button = pygame.Rect(WIDTH//2 - 100, 500, 200, 40)
        pygame.draw.rect(self.screen, GREEN, restart_button)
        restart_text = self.font.render("NEW SIMULATION", True, WHITE)
        self.screen.blit(restart_text, (restart_button.x + 30, restart_button.y + 10))
        
        return restart_button
    
    def get_detection_accuracy(self):
        # Calculate how close our measurements are to real dimensions
        if self.plane_length == 0 or self.plane_width == 0:
            return 0
        
        length_accuracy = min(self.detected_dimensions['length'] / self.plane_length, 
                             self.plane_length / self.detected_dimensions['length']) * 100 if self.detected_dimensions['length'] > 0 else 0
        
        width_accuracy = min(self.detected_dimensions['width'] / self.plane_width,
                           self.plane_width / self.detected_dimensions['width']) * 100 if self.detected_dimensions['width'] > 0 else 0
        
        return (length_accuracy + width_accuracy) / 2
    
    def get_detection_quality(self):
        # Based on number of detected points relative to total plane points
        detected_ratio = len(self.shape_points) / len(self.plane_points) if hasattr(self, 'plane_points') else 0
        
        if detected_ratio >= 0.8:
            return "Excellent"
        elif detected_ratio >= 0.5:
            return "Good"
        elif detected_ratio >= 0.3:
            return "Fair"
        else:
            return "Poor"
    
    def run(self):
        start_button = None
        restart_button = None
        
        while True:
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    pygame.quit()
                    sys.exit()
                
                if event.type == pygame.MOUSEBUTTONDOWN:
                    mouse_pos = pygame.mouse.get_pos()
                    
                    # Input screen logic
                    if self.state == self.STATE_INPUT:
                        start_button = self.draw_input_screen()
                        
                        # Check input fields
                        self.active_input = None
                        for field in self.input_fields:
                            if field["rect"].collidepoint(mouse_pos):
                                self.active_input = field
                        
                        # Check start button
                        if start_button.collidepoint(mouse_pos):
                            try:
                                # Validate and convert inputs
                                self.plane_length = float(self.input_fields[0]["value"] or "50")
                                self.plane_width = float(self.input_fields[1]["value"] or "15")
                                self.plane_speed = float(self.input_fields[2]["value"] or "200")
                                self.plane_direction = float(self.input_fields[3]["value"] or "0")
                                self.plane_altitude = float(self.input_fields[4]["value"] or "10000")
                                
                                # Check stealth status
                                stealth_input = self.input_fields[5]["value"].upper()
                                self.is_stealth = stealth_input in ['Y', 'YES', 'TRUE']
                                
                                # Start simulation
                                self.state = self.STATE_RUNNING
                                self.start_time = time.time()
                            except ValueError:
                                print("Invalid input. Using default values.")
                    
                    # Restart simulation
                    elif self.state == self.STATE_COMPLETE:
                        restart_button = self.draw_results()
                        if restart_button.collidepoint(mouse_pos):
                            self.state = self.STATE_INPUT
                            self.plane_x = -100
                            self.detected_dimensions = {'length': 0, 'width': 0, 'wingspan': 0}
                            for field in self.input_fields:
                                field["value"] = ""
                
                # Text input handling
                if event.type == pygame.KEYDOWN:
                    if self.active_input:
                        if event.key == pygame.K_RETURN:
                            self.active_input = None
                        elif event.key == pygame.K_BACKSPACE:
                            self.active_input["value"] = self.active_input["value"][:-1]
                        else:
                            self.active_input["value"] += event.unicode
            
            # Drawing
            if self.state == self.STATE_INPUT:
                start_button = self.draw_input_screen()
            else:
                self.draw_sky_background()
                self.draw_satellite()
                
                # Animation logic
                if self.state == self.STATE_RUNNING:
                    self.update_animation()
                    self.draw_plane(self.plane_x, self.plane_y, self.plane_angle)
                    
                    # Show realtime stats
                    time_text = self.font.render(f"Time: {self.elapsed_time:.1f}s", True, WHITE)
                    shape_text = self.font.render(f"Shape Points: {len(self.shape_points)}", True, WHITE)
                    
                    # Add semi-transparent background for text readability
                    text_bg = pygame.Surface((180, 70), pygame.SRCALPHA)
                    text_bg.fill((0, 0, 0, 100))
                    self.screen.blit(text_bg, (10, 10))
                    
                    self.screen.blit(time_text, (20, 20))
                    self.screen.blit(shape_text, (20, 50))
                
                if self.state == self.STATE_COMPLETE:
                    self.draw_plane(self.plane_x, self.plane_y, self.plane_angle)
                    restart_button = self.draw_results()
            
            pygame.display.flip()
            self.clock.tick(60)

def main():
    simulation = AircraftDetectionSimulation()
    simulation.run()

if __name__ == "__main__":
    main()
