   def run(self):
       main_sim_button = None
       alt_sim_button = None
       restart_button = None
      
       while True:
           for event in pygame.event.get():
               if event.type == pygame.QUIT:
                   pygame.quit()
                   sys.exit()
              
               if event.type == pygame.MOUSEBUTTONDOWN:
                   mouse_pos = pygame.mouse.get_pos()
                  
                   if self.state == self.STATE_INPUT:
                       main_sim_button, alt_sim_button = self.draw_input_screen()
                      
                       # Check input fields
                       self.active_input = None
                       for field in self.input_fields:
                           if field["rect"].collidepoint(mouse_pos):
                               self.active_input = field
                      
                       # Check which button was clicked
                       if main_sim_button.collidepoint(mouse_pos) or alt_sim_button.collidepoint(mouse_pos):
                           try:
                               self.plane_length = float(self.input_fields[0]["value"] or "50")
                               self.plane_width = float(self.input_fields[1]["value"] or "15")
                               self.plane_direction = float(self.input_fields[2]["value"] or "0")
                              
                               stealth_input = self.input_fields[3]["value"].upper()
                               self.is_stealth = stealth_input in ['Y', 'YES', 'TRUE']
                              
                               # Set appropriate state based on which button was clicked
                               if main_sim_button.collidepoint(mouse_pos):
                                   self.state = self.STATE_RUNNING
                               else:
                                   self.state = self.STATE_RUNNING_ALT
                                   # Reset detection points for alt simulation
                                   self.alt_detection_points = []
                              
                               self.start_time = time.time()
                           except ValueError:
                               print("Invalid input. Using default values.")
                  
                   # Restart simulation
                   elif self.state == self.STATE_COMPLETE:
                       restart_button = self.draw_results()
                       if restart_button.collidepoint(mouse_pos):
                           self.state = self.STATE_INPUT
                           self.detected_dimensions = {'length': 0, 'width': 0, 'wingspan': 0}
                           for field in self.input_fields:
                               field["value"] = ""
              
               # Text input handling
               if event.type == pygame.KEYDOWN:
                   if self.active_input:
                       if event.key == pygame.K_RETURN:
                           self.active_input = None
                       elif event.key == pygame.K_BACKSPACE:
                           self.active_input["value"] = self.active_input["value"][:-1]
                       else:
                           self.active_input["value"] += event.unicode
          
           # Drawing
           if self.state == self.STATE_INPUT:
               main_sim_button, alt_sim_button = self.draw_input_screen()
           elif self.state == self.STATE_RUNNING:
               self.draw_sky_background()
               self.draw_detection_lines()
               self.draw_plane(self.plane_x, self.plane_y, self.plane_angle)
               self.update_animation()
              
               shape_text = self.font.render(f"Shape Points: {len(self.shape_points)}", True, WHITE)
               self.screen.blit(shape_text, (20, 20))
           elif self.state == self.STATE_RUNNING_ALT:
               # Run the alternate simulation
               self.run_alternate_simulation()
           elif self.state == self.STATE_COMPLETE:
               self.draw_sky_background()
               self.draw_detection_lines()
               self.draw_plane(self.plane_x, self.plane_y, self.plane_angle)
               restart_button = self.draw_results()
          
           pygame.display.flip()
           self.clock.tick(60)


