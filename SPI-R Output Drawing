import pygame
import sys
import time
import math
import random

# Initialize Pygame
pygame.init()

# Screen dimensions
WIDTH, HEIGHT = 1200, 800

# Colors
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
SKY_BLUE = (135, 206, 235)
DEEP_SKY_BLUE = (100, 149, 237)
LIGHT_BLUE = (173, 216, 230)
RED = (255, 50, 50)
BLUE = (50, 100, 255)
GREEN = (0, 100, 0)
GRAY = (150, 150, 150)
LIGHT_GRAY = (200, 200, 200)
SILVER = (192, 192, 192)
STEALTH_GRAY = (70, 70, 70)

class AircraftDetectionSimulation:
    def __init__(self):
        # Screen setup
        self.screen = pygame.display.set_mode((WIDTH, HEIGHT))
        pygame.display.set_caption("Advanced Aircraft Detection Simulation")
        self.clock = pygame.time.Clock()
        self.font = pygame.font.Font(None, 24)
        self.title_font = pygame.font.Font(None, 36)
        
        # Background stars
        self.stars = self.generate_stars()
        
        # Simulation parameters
        self.beam_distance = 20.0  # meters
        self.satellite_height = 35000  # meters
        
        # Input parameters
        self.plane_length = 0
        self.plane_speed = 0
        self.plane_direction = 0
        self.plane_altitude = 0
        self.is_stealth = False
        
        # Simulation states
        self.STATE_INPUT = 0
        self.STATE_RUNNING = 1
        self.STATE_COMPLETE = 2
        self.STATE_THEORY = 3
        self.state = self.STATE_INPUT
        
        # Animation variables
        self.start_time = 0
        self.plane_x = -100
        self.plane_y = 250
        self.plane_angle = 0
        
        # Input fields
        self.input_fields = [
            {"label": "Plane Length (m):", "value": "", "rect": pygame.Rect(WIDTH//2 - 150, 300, 200, 30)},
            {"label": "Plane Speed (m/s):", "value": "", "rect": pygame.Rect(WIDTH//2 - 150, 350, 200, 30)},
            {"label": "Direction (degrees):", "value": "", "rect": pygame.Rect(WIDTH//2 - 150, 400, 200, 30)},
            {"label": "Altitude (m):", "value": "", "rect": pygame.Rect(WIDTH//2 - 150, 450, 200, 30)},
            {"label": "Stealth (Y/N):", "value": "", "rect": pygame.Rect(WIDTH//2 - 150, 500, 200, 30)}
        ]
        self.active_input = None
        
        # Radar grid and detection lines
        self.radar_grid = self.create_radar_grid()
        self.detection_lines = self.create_detection_lines()
        self.active_intersections = []
        
        # Elapsed time
        self.elapsed_time = 0
        
    def create_radar_grid(self):
        # Create a grid inspired by the notebook sketch
        grid = []
        grid_size = 8  # Reduced from 10 to make grid more visible
        cell_width = WIDTH // grid_size
        cell_height = HEIGHT // grid_size
        
        for row in range(grid_size):
            for col in range(grid_size):
                grid.append({
                    'rect': pygame.Rect(col * cell_width, row * cell_height, cell_width, cell_height),
                    'detected': False
                })
        return grid
    
    def create_detection_lines(self):
        # Create 16 detection lines radiating from center (inspired by second code)
        lines = []
        center_x, center_y = WIDTH // 2, HEIGHT // 2
        num_lines = 16
        min_length = 150
        max_length = 400
        
        for i in range(num_lines):
            angle = i * (360 / num_lines)
            length = min_length + (i % 3) * ((max_length - min_length) / 2)
            
            end_x = center_x + length * math.cos(math.radians(angle))
            end_y = center_y + length * math.sin(math.radians(angle))
            
            lines.append({
                'id': i,
                'start': [center_x, center_y],
                'end': [end_x, end_y],
                'angle': angle,
                'active': False,
                'intersection': None
            })
        return lines
    
    def generate_stars(self):
        # Generate a background of stars
        stars = []
        for _ in range(150):
            x = random.randint(0, WIDTH)
            y = random.randint(0, 200)  # Stars only in upper part of sky
            size = random.randint(1, 3)
            brightness = random.randint(200, 255)
            stars.append((x, y, size, (brightness, brightness, brightness)))
        return stars
    
    def draw_sky_background(self):
        # Gradient sky background inspired by notebook's clean design
        for y in range(HEIGHT):
            # Create a gradient from deep sky blue to light sky blue
            r = int(DEEP_SKY_BLUE[0] + (SKY_BLUE[0] - DEEP_SKY_BLUE[0]) * (y / HEIGHT))
            g = int(DEEP_SKY_BLUE[1] + (SKY_BLUE[1] - DEEP_SKY_BLUE[1]) * (y / HEIGHT))
            b = int(DEEP_SKY_BLUE[2] + (SKY_BLUE[2] - DEEP_SKY_BLUE[2]) * (y / HEIGHT))
            pygame.draw.line(self.screen, (r, g, b), (0, y), (WIDTH, y))
        
        # Draw subtle grid lines inspired by notebook
        for x in range(0, WIDTH, 50):
            pygame.draw.line(self.screen, (50, 50, 50), (x, 0), (x, HEIGHT), 1)
        for y in range(0, HEIGHT, 50):
            pygame.draw.line(self.screen, (50, 50, 50), (0, y), (WIDTH, y), 1)
        
        # Draw stars
        for star in self.stars:
            pygame.draw.circle(self.screen, star[3], (star[0], star[1]), star[2])
    
    def draw_input_screen(self):
        self.draw_sky_background()
        
        # Title with notebook-style font
        title = self.title_font.render("Aircraft Detection Simulation", True, WHITE)
        self.screen.blit(title, (WIDTH // 2 - title.get_width() // 2, 50))
        
        # Instructions
        instructions = self.font.render("Enter the aircraft parameters to begin the simulation", True, WHITE)
        self.screen.blit(instructions, (WIDTH // 2 - instructions.get_width() // 2, 100))
        
        # Input fields
        for field in self.input_fields:
            # Draw label
            label = self.font.render(field["label"], True, WHITE)
            self.screen.blit(label, (field["rect"].x - label.get_width() - 10, field["rect"].y + 5))
            
            # Draw input box
            color = BLUE if field == self.active_input else GRAY
            pygame.draw.rect(self.screen, color, field["rect"], 2)
            pygame.draw.rect(self.screen, (30, 30, 30), (field["rect"].x, field["rect"].y, field["rect"].width, field["rect"].height))
            
            # Draw input text
            text_surface = self.font.render(field["value"], True, WHITE)
            self.screen.blit(text_surface, (field["rect"].x + 5, field["rect"].y + 5))
        
        # Start button with notebook-inspired style
        start_button = pygame.Rect(WIDTH//2 - 150, 550, 100, 40)
        pygame.draw.rect(self.screen, GREEN, start_button)
        start_text = self.font.render("START", True, WHITE)
        self.screen.blit(start_text, (start_button.x + 25, start_button.y + 10))
        
        # Theory button
        theory_button = pygame.Rect(WIDTH//2 + 50, 550, 100, 40)
        pygame.draw.rect(self.screen, BLUE, theory_button)
        theory_text = self.font.render("THEORY", True, WHITE)
        self.screen.blit(theory_text, (theory_button.x + 20, theory_button.y + 10))
        
        return start_button, theory_button
    
    def draw_theory_screen(self):
        self.draw_sky_background()
        
        # Title
        title = self.title_font.render("Aircraft Detection Theory", True, WHITE)
        self.screen.blit(title, (WIDTH // 2 - title.get_width() // 2, 50))
        
        # Configuration details
        config_title = self.font.render("Current Configuration:", True, WHITE)
        self.screen.blit(config_title, (WIDTH // 4 - 100, 120))
        
        # Only show config if we have set values
        if self.plane_length > 0:
            configs = [
                f"Plane Length: {self.plane_length} m",
                f"Plane Speed: {self.plane_speed} m/s",
                f"Direction: {self.plane_direction} degrees",
                f"Altitude: {self.plane_altitude} m",
                f"Stealth Status: {'Enabled' if self.is_stealth else 'Disabled'}"
            ]
            
            for i, config in enumerate(configs):
                text = self.font.render(config, True, WHITE)
                self.screen.blit(text, (WIDTH // 4 - 100, 160 + i * 30))
        
        # Detection theory
        theory_title = self.font.render("Detection Theory:", True, WHITE)
        self.screen.blit(theory_title, (WIDTH // 2 + 100, 120))
        
        theory_points = [
            "• 16-line detection system uses radial beams",
            "• Each line detects aircraft crossing its path",
            "• 2-beam satellite system provides cross-verification",
            "• Stealth aircraft have 70% lower detection probability",
            "• Higher altitude reduces detection probability",
            "• Multiple intersections enable triangulation",
            "• Shape detection requires 3+ detection points",
        ]
        
        for i, point in enumerate(theory_points):
            text = self.font.render(point, True, WHITE)
            self.screen.blit(text, (WIDTH // 2 + 50, 160 + i * 30))
        
        # Detection mechanics
        mechanics_title = self.font.render("Detection Mechanics:", True, WHITE)
        self.screen.blit(mechanics_title, (WIDTH // 2 - mechanics_title.get_width() // 2, 400))
        
        mechanics = [
            "1. System calculates closest point on each line to the aircraft",
            "2. If distance is less than aircraft size, detection check is made",
            "3. Stealth aircraft: 30% detection chance, Normal: 90% chance",
            "4. Multiple detections enable triangulation for position and size",
            "5. Cross-verification with satellite beams improves accuracy"
        ]
        
        for i, point in enumerate(mechanics):
            text = self.font.render(point, True, WHITE)
            self.screen.blit(text, (WIDTH // 2 - text.get_width() // 2, 440 + i * 30))
        
        # Back button
        back_button = pygame.Rect(WIDTH//2 - 50, 650, 100, 40)
        pygame.draw.rect(self.screen, RED, back_button)
        back_text = self.font.render("BACK", True, WHITE)
        self.screen.blit(back_text, (back_button.x + 30, back_button.y + 10))
        
        return back_button
    
    def draw_satellite(self, time_offset=0):
        # Satellite position
        sat_x, sat_y = WIDTH // 2, 100
        
        # Main body (central solar panel array)
        pygame.draw.rect(self.screen, GRAY, (sat_x - 60, sat_y - 10, 120, 20))
        
        # Solar panels
        pygame.draw.rect(self.screen, SILVER, (sat_x - 80, sat_y - 20, 20, 40))
        pygame.draw.rect(self.screen, SILVER, (sat_x + 60, sat_y - 20, 20, 40))
        
        # Radar beam visualization - animate slightly
        beam_width = 2
        beam_color = RED
        beam_angle1 = 20 + math.sin(time_offset * 2) * 5
        beam_angle2 = -20 + math.sin(time_offset * 2) * 5
        
        # Calculate beam endpoints
        beam1_end_x = sat_x + math.tan(math.radians(beam_angle1)) * (HEIGHT - sat_y)
        beam2_end_x = sat_x + math.tan(math.radians(beam_angle2)) * (HEIGHT - sat_y)
        
        pygame.draw.line(self.screen, beam_color, (sat_x, sat_y), (beam1_end_x, HEIGHT), beam_width)
        pygame.draw.line(self.screen, beam_color, (sat_x, sat_y), (beam2_end_x, HEIGHT), beam_width)
    
    def draw_detection_lines(self):
        # Draw the 16 detection lines
        center_x, center_y = WIDTH // 2, HEIGHT // 2
        
        # First draw inactive lines
        for line in self.detection_lines:
            if not line['active']:
                pygame.draw.line(
                    self.screen,
                    GRAY,
                    line['start'],
                    line['end'],
                    1
                )
        
        # Then draw active lines (so they appear on top)
        for line in self.detection_lines:
            if line['active']:
                pygame.draw.line(
                    self.screen,
                    GREEN,
                    line['start'],
                    line['end'],
                    2
                )
                
                # Draw intersection point
                if line['intersection']:
                    pygame.draw.circle(
                        self.screen,
                        RED,
                        line['intersection'],
                        5
                    )
        
        # Draw radar center
        pygame.draw.circle(self.screen, BLUE, (center_x, center_y), 10)
    
    def draw_radar_grid(self):
        # Draw the radar detection grid
        for cell in self.radar_grid:
            color = BLUE if cell['detected'] else (50, 50, 50)
            pygame.draw.rect(self.screen, color, cell['rect'], 1)
    
    def draw_plane(self, x, y, angle=0, scale=1.0):
        # Plane color based on stealth status
        plane_color = STEALTH_GRAY if self.is_stealth else SILVER
        
        # Create a more detailed plane representation
        # Scale with plane_length
        body_length = 40 * scale
        body_width = 6 * scale
        
        # Detection radius
        radius = body_length * 0.75
        pygame.draw.circle(self.screen, (100, 100, 100, 50), (x, y), radius, 1)
        
        # Rotate the plane
        rotated_points = []
        body_points = [
            (-body_length/2, -body_width/2),   # Left wing tip
            (body_length/2, 0),                # Nose
            (-body_length/2, body_width/2)     # Right wing tip
        ]
        
        # Rotation matrix
        cos_a = math.cos(math.radians(angle))
        sin_a = math.sin(math.radians(angle))
        
        for px, py in body_points:
            rotated_x = px * cos_a - py * sin_a
            rotated_y = px * sin_a + py * cos_a
            rotated_points.append((rotated_x + x, rotated_y + y))
        
        # Draw the plane body
        pygame.draw.polygon(self.screen, plane_color, rotated_points)
    
    def update_radar_detection(self):
        # Reset all lines to inactive
        for line in self.detection_lines:
            line['active'] = False
            line['intersection'] = None
        
        self.active_intersections = []
        
        # Plane radius (based on length)
        plane_radius = (self.plane_length / 100.0) * 40  # Scale factor
        
        # Check each detection line
        for line in self.detection_lines:
            line_start_x, line_start_y = line['start']
            line_end_x, line_end_y = line['end']
            
            # Line vector
            line_dir_x = line_end_x - line_start_x
            line_dir_y = line_end_y - line_start_y
            line_length = math.sqrt(line_dir_x**2 + line_dir_y**2)
            
            if line_length > 0:
                # Normalized direction
                norm_dir_x = line_dir_x / line_length
                norm_dir_y = line_dir_y / line_length
                
                # Vector from line start to plane
                to_plane_x = self.plane_x - line_start_x
                to_plane_y = self.plane_y - line_start_y
                
                # Project onto line direction
                projection = to_plane_x * norm_dir_x + to_plane_y * norm_dir_y
                
                # Find closest point on line to plane
                closest_x = line_start_x + projection * norm_dir_x
                closest_y = line_start_y + projection * norm_dir_y
                
                # Distance from closest point to plane
                dist = math.sqrt((closest_x - self.plane_x)**2 + (closest_y - self.plane_y)**2)
                
                # Check if within detection range and within line segment
                if dist < plane_radius and 0 <= projection <= line_length:
                    # Apply stealth probability calculation
                    detection_probability = 0.3 if self.is_stealth else 0.9
                    is_detected = random.random() < detection_probability
                    
                    if is_detected:
                        line['active'] = True
                        line['intersection'] = [closest_x, closest_y]
                        self.active_intersections.append([closest_x, closest_y])
        
        # Update grid cells based on plane position
        for cell in self.radar_grid:
            if cell['rect'].collidepoint(self.plane_x, self.plane_y):
                # Stealth planes have lower detection probability
                if not self.is_stealth or random.random() > 0.7:
                    cell['detected'] = True
    
    def draw_results(self):
        # Get number of detections
        active_lines_count = len([line for line in self.detection_lines if line['active']])
        detected_cells = len([cell for cell in self.radar_grid if cell['detected']])
        
        # Background for results panel
        results_panel = pygame.Rect(WIDTH // 2 - 250, 300, 500, 250)
        pygame.draw.rect(self.screen, (0, 0, 0, 128), results_panel)
        pygame.draw.rect(self.screen, WHITE, results_panel, 2)
        
        # Panel title
        title = self.font.render("Detection Results", True, WHITE)
        self.screen.blit(title, (WIDTH // 2 - title.get_width() // 2, 310))
        
        # Result data
        results = [
            f"Plane Length: {self.plane_length:.2f} m",
            f"Plane Speed: {self.plane_speed:.2f} m/s",
            f"Direction: {self.plane_direction:.2f} degrees",
            f"Altitude: {self.plane_altitude:.2f} m",
            f"Stealth Status: {'Stealth' if self.is_stealth else 'Conventional'}",
            f"Active Detection Lines: {active_lines_count}/16",
            f"Detected Grid Cells: {detected_cells}",
            f"Time Elapsed: {self.elapsed_time:.1f} seconds",
            f"Detection Quality: {self.get_detection_quality(active_lines_count)}",
            f"{'SHAPE DETECTED: Aircraft' if active_lines_count >= 3 else 'Insufficient data for shape detection'}"
        ]
        
        for i, result in enumerate(results):
            text = self.font.render(result, True, WHITE)
            self.screen.blit(text, (WIDTH // 2 - 220, 340 + i * 25))
        
        # Draw restart button
        restart_button = pygame.Rect(WIDTH//2 - 100, 520, 200, 40)
        pygame.draw.rect(self.screen, GREEN, restart_button)
        restart_text = self.font.render("NEW SIMULATION", True, WHITE)
        self.screen.blit(restart_text, (restart_button.x + 30, restart_button.y + 10))
        
        return restart_button
    
    def get_detection_quality(self, active_lines_count):
        if active_lines_count >= 6:
            return "Excellent"
        elif active_lines_count >= 4:
            return "Good"
        elif active_lines_count >= 2:
            return "Fair"
        else:
            return "Poor"
    
    def update_animation(self):
        # Use smoother interpolation for animation
        elapsed_time = time.time() - self.start_time
        self.elapsed_time = elapsed_time
        total_animation_time = 6  # Total simulation time
        
        # Calculate normalized time (0 to 1)
        t = min(elapsed_time / total_animation_time, 1)
        
        # Smooth interpolation using cubic ease in-out
        def ease_cubic(t):
            return 3 * t**2 - 2 * t**3
        
        t_smooth = ease_cubic(t)
        
        # Calculate plane position
        # More realistic flight path that curves slightly
        path_width = WIDTH + 200  # include off-screen areas
        
        self.plane_x = -100 + t_smooth * path_width
        
        # Add slight vertical movement based on direction
        vertical_offset = math.sin(t * math.pi * 2) * 60
        self.plane_y = HEIGHT / 2 + vertical_offset
        
        # Adjust angle based on vertical movement
        self.plane_angle = self.plane_direction + math.sin(t * math.pi * 4) * 10
        
        # Update radar detection
        self.update_radar_detection()
        
        # Check if animation is complete
        if t >= 1:
            self.state = self.STATE_COMPLETE

    def run(self):
        start_button = None
        theory_button = None
        back_button = None
        restart_button = None
        
        while True:
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    pygame.quit()
                    sys.exit()
                
                if event.type == pygame.MOUSEBUTTONDOWN:
                    mouse_pos = pygame.mouse.get_pos()
                    
                    # Input screen logic
                    if self.state == self.STATE_INPUT:
                        start_button, theory_button = self.draw_input_screen()
                        
                        # Check input fields
                        self.active_input = None
                        for field in self.input_fields:
                            if field["rect"].collidepoint(mouse_pos):
                                self.active_input = field
                        
                        # Check start button
                        if start_button.collidepoint(mouse_pos):
                            try:
                                # Validate and convert inputs
                                self.plane_length = float(self.input_fields[0]["value"])
                                self.plane_speed = float(self.input_fields[1]["value"])
                                self.plane_direction = float(self.input_fields[2]["value"])
                                self.plane_altitude = float(self.input_fields[3]["value"])
                                
                                # Check stealth status
                                stealth_input = self.input_fields[4]["value"].upper()
                                self.is_stealth = stealth_input in ['Y', 'YES', 'TRUE']
                                
                                # Start simulation
                                self.state = self.STATE_RUNNING
                                self.start_time = time.time()
                                self.radar_grid = self.create_radar_grid()  # Reset grid
                            except ValueError:
                                print("Invalid input. Please enter numeric values.")
                        
                        # Check theory button
                        if theory_button.collidepoint(mouse_pos):
                            self.state = self.STATE_THEORY
                    
                    # Theory screen logic
                    elif self.state == self.STATE_THEORY:
                        back_button = self.draw_theory_screen()
                        
                        if back_button.collidepoint(mouse_pos):
                            self.state = self.STATE_INPUT
                    
                    # Restart simulation if complete
                    elif self.state == self.STATE_COMPLETE:
                        restart_button = self.draw_results()
                        if restart_button.collidepoint(mouse_pos):
                            self.state = self.STATE_INPUT
                            self.plane_x = -100
                            for field in self.input_fields:
                                field["value"] = ""
                            
                            # Reset radar grid
                            self.radar_grid = self.create_radar_grid()
                
                # Text input handling
                if event.type == pygame.KEYDOWN:
                    if self.active_input:
                        if event.key == pygame.K_RETURN:
                            self.active_input = None
                        elif event.key == pygame.K_BACKSPACE:
                            self.active_input["value"] = self.active_input["value"][:-1]
                        else:
                            self.active_input["value"] += event.unicode
            
            # Drawing
            if self.state == self.STATE_INPUT:
                start_button, theory_button = self.draw_input_screen()
            elif self.state == self.STATE_THEORY:
                back_button = self.draw_theory_screen()
            else:
                self.draw_sky_background()
                
                # Draw detection context elements
                self.draw_satellite(time.time())  # Pass time for animation
                self.draw_detection_lines()
                self.draw_radar_grid()
                
                # Animation logic
                if self.state == self.STATE_RUNNING:
                    self.update_animation()
                    plane_scale = self.plane_length / 40 if self.plane_length else 1.0
                    self.draw_plane(self.plane_x, self.plane_y, self.plane_angle, plane_scale)
                    
                    # Show realtime stats
                    active_lines = len([line for line in self.detection_lines if line['active']])
                    time_text = self.font.render(f"Time: {self.elapsed_time:.1f}s", True, WHITE)
                    detect_text = self.font.render(f"Active Lines: {active_lines}/16", True, WHITE)
                    
                    self.screen.blit(time_text, (20, 20))
                    self.screen.blit(detect_text, (20, 50))
                
                if self.state == self.STATE_COMPLETE:
                    plane_scale = self.plane_length / 40 if self.plane_length else 1.0
                    self.draw_plane(self.plane_x, self.plane_y, self.plane_angle, plane_scale)
                    restart_button = self.draw_results()
            
            # Update display
            pygame.display.flip()
            self.clock.tick(30)

def main():
    simulation = AircraftDetectionSimulation()
    simulation.run()

if __name__ == "__main__":
    main()
