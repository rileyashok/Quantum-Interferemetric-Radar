           self.screen.blit(text_surface, (10, y_offset))
           y_offset += 25
       
       # Check if animation is complete
       if elapsed_time >= 10:  # Extended time for this simulation
           self.state = self.STATE_COMPLETE

   def get_shape_classification(self):
       if len([line for line in self.detection_lines if line['active']]) < 3:
           return "Unknown (insufficient data)"
      
       if self.detected_dimensions['length'] > 0 and self.detected_dimensions['width'] > 0:
           aspect_ratio = self.detected_dimensions['length'] / self.detected_dimensions['width']
          
           if aspect_ratio > 7:
               return "Likely Reconnaissance Aircraft"
           elif aspect_ratio > 5:
               return "Standard Fighter Aircraft"
           elif aspect_ratio > 3: 
               return "Commercial Passenger Aircraft"
           elif aspect_ratio > 1.5:
               return "Transport/Cargo Aircraft"
           else:
               return "Unknown Aircraft Type"
       return "Shape Analysis Incomplete"


