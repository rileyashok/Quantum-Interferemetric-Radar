    #d = (parenthesis2)d

    #MATH CODED
    parenthesis1 = timeSilent/timeRight
    parenthesis2 = parenthesis1 + 1
    planeLength = parenthesis2 * beamDistance
    
    #PRINT STATEMENTS
    #print(f"The length of the plane is: {planeLength} meters")

    #RETURN STATEMENTS
    return planeLength

def find_velocity(timeRight):
    #MATH EQUATIONS
