# Functions using optical sensor 1 to get times
def detect_timeRight1():
    #brain.screen.print("Waiting for red detection...")
    
    while True:
        hue1 = optical_1.hue()  # Get color hue

        # Check if hue corresponds to red (typically between 0-60 degrees)
        if 0 <= hue <= 60: #FIND THE VALUES THAT ARE HALF RED
            timeRight = brain.timer.time(vex.SECONDS)  # Capture time in seconds
            #brain.screen.clear_screen()
            #brain.screen.print(f"Red detected at: {detected_time:.2f} seconds")
        
            break  # Stop loop once red is detected
        
        return timeRight1
        vex.wait(50)  # Small delay to reduce CPU usage

def detect_timeLeft1():

    while True:
        hue11 = optical_1.hue() # Get hue color

        # Check whether hue is not red
        if 60 <= hue <= 360: #FIND VALUES OF NO RED
            
            timeLeft = brain.timer.time(vex.SECONDS) #time in seconds

            break

        return timeLeft1
        vex.wait(50)

