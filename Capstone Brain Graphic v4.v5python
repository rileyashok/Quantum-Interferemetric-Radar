#Velocity function, only using Right1 because I'm lazy and whats the difference
def find_velocity(timeRight1):
    #MATH EQUATIONS
    #v = d/tr

    #MATH CODED
    planeVelocity = beamDistance / timeRight1

    #PRINT STATEMENTS
    #print(f"The velocity of the plane is: {planeVelocity} m/s")
    #print(f"----------------------------------")
    #print(f" ")

    #RETURN STATEMENT
    return planeVelocity

