#define some variables
beamDistance = 0.26 #meters

timeSilent1 = timeLeft1 - timeRight1
timeSilent2 = timeLeft2 - timeRight2
timeSilent3 = timeLeft3 - timeRight3
timeSilent4 = timeLeft4 - timeRight4
timeSilent5 = timeLeft5 - timeRight5
timeSilent6 = timeLeft6 - timeRight6

#Find plane lengths
def find_length1(timeSilent1, timeRight1):
    #MATH EQUATIONS
    #d = ((ts/tr)+1)d
    #d = ((parenthesis1)+1)d
    #d = (parenthesis2)d

    #MATH CODED
    parenthesis1 = timeSilent1/timeRight1
    parenthesis2 = parenthesis1 + 1
    planeLength = parenthesis2 * beamDistance
    
    #PRINT STATEMENTS
    #print(f"The length of the plane is: {planeLength} meters")

    #RETURN STATEMENTS
    return planeLength1


def find_length2(timeSilent2, timeRight2):
    #MATH EQUATIONS
